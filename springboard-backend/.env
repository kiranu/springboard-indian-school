# Django
SECRET_KEY=springboard-sbis-secret-key-2026-hyderabad-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — XAMPP MySQL
DB_NAME=sbis_website
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS — allow React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (optional for local dev — set later for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Springboard Indian School <admissions@springboardindianschool.edu.in>
ADMINS_EMAIL=admissions@springboardindianschool.edu.in

# Redis (optional for local dev — Celery disabled without this)
REDIS_URL=redis://localhost:6379/0

# Frontend URL
FRONTEND_URL=http://localhost:5173
